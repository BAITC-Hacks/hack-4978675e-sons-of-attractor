# Optional: Docker Compose reads .env in the project root automatically.
# With no keys, the form and all 8 demos work against the bundled 66-row CSV.
# Keys are runtime-only; never put them into frontend files or commit .env.

# Simple setup: one shared key enables both text parsing and AI explanations.
# OpenAI wins when BOTH providers have a key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-sonnet-5

# Independent stages. A non-empty stage key/model overrides its shared value.
# To use different providers per stage, leave both shared API keys empty.
PARSE_ENABLED=true
PARSE_OPENAI_API_KEY=
PARSE_ANTHROPIC_API_KEY=
PARSE_OPENAI_MODEL=
PARSE_ANTHROPIC_MODEL=

ANSWER_ENABLED=true
ANSWER_OPENAI_API_KEY=
ANSWER_ANTHROPIC_API_KEY=
ANSWER_OPENAI_MODEL=
ANSWER_ANTHROPIC_MODEL=

# Optional local Python/legacy offline registry paths (Docker uses fixed paths).
DATASET_PATH=backend/data/catalog.csv
FACTS_PATH=backend/data/facts.json
